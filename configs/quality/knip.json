{
  "$schema": "https://unpkg.com/knip@5.70.1/schema.json",
  "project": [
    "src/**/*.{astro,mdx,js,jsx,mjs,cjs,ts,tsx,mts,cts}",
    "*.{js,mjs,cjs,ts,mts,cts}",
    "scripts/**/*.{js,mjs,cjs,ts,mts,cts}",
    "tests/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}",
    "configs/**/*.{js,mjs,cjs,ts,mts,cts}"
  ],
  "entry": [
    "scripts/dead-code/audit.mjs",
    "scripts/dead-code/verify-tools.mjs",
    "scripts/markup/worker.*js",
    "tests/functional/audits/dead-code/*.test.mjs",
    "tests/fixtures/metadata/dataset-metadata.*js",
    "src/features/studies/viewable-images.js",
    "src/features/search/client/controller.js",
    "src/layouts/HelpLayout.astro",
    "src/layouts/PoliciesLayout.astro",
    "src/layouts/MarkdownLayoutLeftAlign.astro",
    "scripts/catalogue/preload.mjs",
    "src/features/projects/spora/dataset-browser.ts",
    "src/features/projects/spora/project-controls.js",
    "tests/support/website/server.mjs"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/.astro/**",
    "**/dist/**",
    "**/.netlify/**",
    "**/coverage/**",
    "**/artifacts/**"
  ],
  "eslint": {
    "config": [
      "configs/quality/eslint.config.mjs",
      "configs/quality/eslint.markup.config.*js",
      "eslint.config.{js,mjs,cjs,ts}",
      "configs/security/eslint.config.mjs"
    ]
  },
  "playwright": {
    "config": [
      "configs/testing/playwright.config.ts"
    ]
  }
}
