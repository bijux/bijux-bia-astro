{
  "name": "bia-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && cp public/robots.txt dist/robots.txt && cp public/redirect_index.html dist/index.html",
    "preview": "astro preview",
    "astro": "astro",
    "prod": "NODE_ENV=production PORT=8080 HOST=0.0.0.0 node dist/bioimage-archive/server/entry.mjs",
    "local": "astro check && astro build && astro preview",
    "doctor": "node scripts/development/bootstrap.mjs doctor",
    "clean": "node scripts/development/clean.mjs",
    "check": "astro check",
    "test": "node --test tests/development/*.test.mjs",
    "report-test": "python3 -B -m scripts.reports.tests",
    "report": "python3 -B -m scripts.reports build",
    "report-check": "python3 -B -m scripts.reports validate",
    "setup": "node scripts/development/bootstrap.mjs install",
    "candidate": "python3 -B -m scripts.verification.staged",
    "verification-test": "python3 -B -m scripts.verification.tests"
  },
  "dependencies": {
    "@astrojs/check": "^0.2.1",
    "@astrojs/mdx": "^4.0.2",
    "@astrojs/netlify": "^6.4.0",
    "@astrojs/node": "^9.2.2",
    "astro": "^5.0",
    "datatables.net": "^2.1.0",
    "datatables.net-dt": "^2.1.0",
    "jquery": "^3.7.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/datatables.net": "^1.10.28",
    "@types/jquery": "^3.5.29",
    "@types/node": "^20.11.24"
  }
}
