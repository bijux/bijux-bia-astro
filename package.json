{
  "name": "bia-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "audit:markup": "node scripts/markup/audit.mjs",
    "test:markup": "node --test tests/markup/*.test.mjs",
    "quality:markup:check": "astro check --tsconfig configs/quality/tsconfig.markup.json",
    "start": "astro dev",
    "build": "astro check && astro build && cp public/robots.txt artifacts/dist/robots.txt && cp public/redirect_index.html artifacts/dist/index.html",
    "build:deployment": "node scripts/deployment/build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "audit:dead-code": "node scripts/dead-code/audit.mjs",
    "audit:dead-code:knip": "knip --config configs/quality/knip.json --reporter json",
    "test:dead-code": "node --test tests/dead-code/*.test.mjs",
    "quality:check": "astro check --tsconfig configs/quality/tsconfig.check.json",
    "test:galleries": "node --test tests/galleries/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "prod": "NODE_ENV=production node scripts/server.mjs",
    "local": "astro check && astro build && astro preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:metadata": "node --test tests/metadata/*.test.mjs",
    "test:fbbi": "node --test tests/ontology/*.test.mjs",
    "test:news": "node --test tests/news/*.test.mjs",
    "audit:security": "node scripts/security/audit.mjs",
    "postinstall": "node scripts/build/artifacts.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/netlify": "8.2.10",
    "@astrojs/node": "11.1.8",
    "astro": "7.4.0",
    "datatables.net": "^2.1.0",
    "datatables.net-dt": "^2.1.0",
    "jquery": "^3.7.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@astrojs/compiler": "4.0.0",
    "@rollup/plugin-yaml": "5.0.0",
    "@types/datatables.net": "^1.10.28",
    "@types/jquery": "^3.5.29",
    "@types/node": "^20.11.24",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.3.1",
    "html-validate": "10.17.0",
    "knip": "5.70.1",
    "typescript-eslint": "8.48.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
