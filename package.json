{
  "name": "bia-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "audit:markup": "node scripts/audits/markup/audit.mjs",
    "test:markup": "node --test tests/functional/audits/markup/*.test.mjs",
    "start": "astro dev",
    "build": "node scripts/catalogue/build.mjs",
    "build:deployment": "node scripts/deployment/build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "audit:dead-code": "node scripts/audits/dead-code/audit.mjs",
    "audit:dead-code:knip": "knip --config configs/audits/dead-code/knip.json --reporter json",
    "test:dead-code": "node --test tests/functional/audits/dead-code/*.test.mjs",
    "test:galleries": "node --test \"tests/functional/galleries/**/*.test.mjs\"",
    "prod": "NODE_ENV=production node src/server/host.mjs",
    "local": "npm run build && astro preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:metadata": "node --test tests/functional/api/capture-provenance.test.mjs tests/unit/metadata/*.test.mjs tests/functional/metadata/*.test.mjs",
    "test:fbbi": "node --test tests/unit/metadata/fbbi-terms.test.mjs tests/functional/metadata/ontology-rendering.test.mjs",
    "test:news": "node --test tests/unit/news/*.test.mjs tests/functional/news/*.test.mjs",
    "audit:security": "node scripts/audits/security/audit.mjs",
    "postinstall": "node scripts/build/artifacts.mjs",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=artifacts/browsers playwright test --config configs/testing/playwright.config.ts",
    "check": "astro check --tsconfig configs/typescript/check.json",
    "test:controls": "node --test tests/functional/studies/*.test.mjs tests/functional/images/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/netlify": "8.2.10",
    "@astrojs/node": "11.1.8",
    "astro": "7.4.0",
    "datatables.net": "2.3.2",
    "datatables.net-dt": "2.3.2",
    "jquery": "3.7.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@astrojs/compiler": "4.0.0",
    "@rollup/plugin-yaml": "5.0.0",
    "@types/jquery": "^3.5.29",
    "@types/node": "^20.11.24",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.0",
    "html-validate": "10.17.0",
    "knip": "6.41.0",
    "typescript-eslint": "8.48.1",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
