---
import { normaliseNavigationPath } from './paths.mjs';
interface Props { pageTitle: string; pagePath: string | readonly string[] }
const { pageTitle, pagePath } = Astro.props;
function ancestorPaths(path: string): string[] {
    const segments = normaliseNavigationPath(path).split('/');
    const ancestors = [];
    for (let end = 2; end < segments.length; end++) ancestors.push(segments.slice(0, end).join('/'));
    return ancestors;
}
const breadcrumbs = typeof pagePath === 'string' ? ancestorPaths(pagePath) : pagePath;
---
<nav aria-label="Breadcrumb" style="padding-bottom: 2rem;">
    <ol>
        {breadcrumbs.map(breadcrumb => (
            <li>
                <a href={breadcrumb}>{breadcrumb.split('/').pop()}</a>
                <span aria-hidden="true">&gt;</span>
            </li>
        ))}
        <li aria-current="page"><b>{pageTitle}</b></li>
    </ol>
</nav>
<style>
    nav, ol, li { display: flex; }
    ol {
        justify-content: left;
        align-content: center;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }
    li { gap: 0.5rem; }
    a { color: black; }
    a, span, b { font-size: small; }
</style>
