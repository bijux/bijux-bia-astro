---
const { frontmatter } = Astro.props;
import SectionNavigation from '../components/navigation/SectionNavigation.astro';
import { policyLinkGroups } from '../components/navigation/section-links.mjs';
import BaseLayout from './BaseLayout.astro';

---
<BaseLayout pageTitle={frontmatter.title}>
  <section class="embl-grid embl-grid--has-centered-content">
    <div>
      <SectionNavigation label="Policies" groups={policyLinkGroups} />
    </div>
    <div class="vf-content">
      <slot />
    </div>
  </section>
</BaseLayout>