---
import '../styles/bars_and_sections.css';
import Document from './document/Document.astro';
import EMPIARHeader from './document/EMPIARHeader.astro';
import Navigation from '../components/navigation/Navigation.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import Announcement from '../features/news/Announcement.astro';
const { pageTitle, breadcrumbs } = Astro.props;
const pagePath = breadcrumbs ?? Astro.url.pathname;
---
<Document pageTitle={`EMPIAR - ${pageTitle}`} icon="EMPIAR_logo.svg" tables>
  <EMPIARHeader />
  <Navigation />
  <Announcement />
  <Breadcrumbs pageTitle={pageTitle} pagePath={pagePath} />
  <slot />
</Document>
