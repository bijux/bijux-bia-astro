---
import "../styles/button-shape.css";
import "/src/styles/bars_and_sections.css"
import Analytics from "../components/Analytics.astro";
import 'datatables.net';

import 'datatables.net-dt';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import Announcement from "../components/Announcement.astro";
const { pageTitle } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---
<html lang="en" class="vf-js" style="scroll-padding-top: 48px">
  <head>
    <!-- Google tag (gtag.js) -->
		<Analytics />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/BIA-logo.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- CSS only -->
    <link rel="stylesheet" href="https://assets.emblstatic.net/vf/v2.5.12/css/styles.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.min.css" />

    <!-- JS -->
    <script is:inline src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha384-wsqsSADZR1YRBEZ4/kKHNSmU+aX8ojbnKUMN4RyD3jDkxw5mHtoe2z/T/n4l56U/" crossorigin="anonymous"></script>
    <script is:inline src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>

    <meta name="robots" content="noindex, nofollow">

    <title>{pageTitle}</title>
    <link rel="import" href="https://www.embl.org/api/v1/pattern.html?filter-content-type=article&filter-id=106902&pattern=node-body&source=contenthub" data-target="embl-contenthub-footer" data-embl-js-content-hub-loader/>
    <link rel="stylesheet" href="https://assets.emblstatic.net/vf/v2.5.8/assets/ebi-header-footer/ebi-header-footer.css" type="text/css" media="all">
    <link rel="stylesheet" href="https://ebi.emblstatic.net/web_guidelines/EBI-Icon-fonts/v1.3/fonts.css" type="text/css" media="all">
  </head>
  <body class="vf-body">
    <header id="masthead-black-bar" class="clearfix masthead-black-bar | ebi-header-footer vf-content vf-u-fullbleed"></header>
  <script defer="defer" src="//ebi.emblstatic.net/web_guidelines/EBI-Framework/v1.4/js/script.js"></script>

    <Header />
    <Navigation />
    <Announcement />
    <slot />
    <Footer />
    <div class="embl-contenthub-footer vf-content-hub-html"></div>
    <!-- Script required for bottom bar -->
    <script src="https://assets.emblstatic.net/vf/v2.5.12/scripts/scripts.js"/>
  </body>
</html>
