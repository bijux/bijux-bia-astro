---
const { frontmatter } = Astro.props;
import HelpNavigation from '../components/navigation/HelpNavigation.astro';
import HelpSearchMenu from '../components/navigation/HelpSearchMenu.astro';
import BaseLayout from './BaseLayout.astro';
---
<BaseLayout pageTitle={frontmatter.title}>
  <section class="embl-grid embl-grid--has-centered-content">
    <div>
      <HelpNavigation />
    </div>
    <div class="vf-content">
      <slot />
    </div>
    {frontmatter.showSearchRightMenu && (
      <div>
        <HelpSearchMenu />
      </div>
    )}
  </section>
</BaseLayout>
