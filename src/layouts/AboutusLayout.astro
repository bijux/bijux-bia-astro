---
const { frontmatter } = Astro.props;
import SectionNavigation from '../components/navigation/SectionNavigation.astro';
import { aboutLinkGroups } from '../components/navigation/section-links.mjs';
import BaseLayout from './BaseLayout.astro';
import RightMenuCard from '../components/navigation/RightMenu.astro';
---

<BaseLayout pageTitle={frontmatter.title}>
  <section class="embl-grid embl-grid--has-centered-content">
    <div>
      <SectionNavigation label="About" groups={aboutLinkGroups} />
    </div>
    <div class="vf-content">
      <slot />
    </div>
    <div>
      <RightMenuCard />
    </div>
  </section>
</BaseLayout>
