---

---
<div>
  <h2 class="vf-section-header vf-section-header__heading">Training</h2>
  <br/>
  <div class="vf-grid vf-tabs">
    <ul class="vf-tabs__list" data-vf-js-tabs>
      <li class="vf-tabs__item">
        <a class="vf-link vf-tabs__link" href="#vf-tabs__section--1">On-demand training</a>
      </li>
      <li class="vf-tabs__item">
        <a class="vf-link vf-tabs__link" href="#vf-tabs__section--2">Live training</a>
      </li>
    </ul>
  </div>

  <div class="vf-tabs-content" data-vf-js-tabs-content>
    <section class="vf-tabs__section" id="vf-tabs__section--1">
      <div id="ondemand-tutorials"></div>
      <a href="https://www.ebi.ac.uk/training/on-demand?query=bioimage-archive&domain=ebiweb_training_online" class="vf-link" target="_blank">View all on-demand training</a>
    </section>
    <section class="vf-tabs__section" id="vf-tabs__section--2">
      <div id="live-tutorials"></div>
      <a href="https://www.ebi.ac.uk/training/live-events?query=bioimage-archive&domain=ebiweb_training_events" class="vf-link" target="_blank">View all live training</a>
    </section>
  </div>
</div>

<script>
    import { getTrainingEntries } from "../../api/training.mjs";
    import { renderTutorials } from "./tutorials.mjs";

    async function fetchTutorials(type, containerId) {
        const container = document.getElementById(containerId);
        if (!container) return;
        try {
            const entries = await getTrainingEntries(type);
            renderTutorials(container, entries, type);
        } catch {
            const message = document.createElement("p");
            message.textContent = "Training events are temporarily unavailable. Use the link below to view them.";
            container.replaceChildren(message);
        }
    }
    document.addEventListener("DOMContentLoaded", () => {
        fetchTutorials("live", "live-tutorials");
        fetchTutorials("ondemand", "ondemand-tutorials");
    });
</script>
