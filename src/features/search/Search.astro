---
import "./search.css";
import StudyCard from './BrowseStudyCard.astro';
import ImageCard from './BrowseImageCard.astro';
import SearchFacet from './SearchFacet.astro';
import SearchSelectedFacet from './SearchSelectedFacet.astro';
import PaginationControl from './PaginationControl.astro';
import "../../styles/toggle.css";
import "../../styles/browse_controls.css";
import "../../styles/filter_cards.css";
import SearchResultsTable from './SearchResultsTable.astro';
import SearchResultsCompactCards from './SearchCompactCards.astro';
import { PUBLIC_SEARCH_API } from 'astro:env/client';
import { loadSearchPage } from './load-search.ts';
import type { SearchScope } from './types.ts';

const { url, query, searchType } = Astro.props as {url: URL; query: string; searchType: SearchScope};
const { requestError, status, searchPageURL, totalResults, results, paginationData, facets, pageSize,
    cappedPage, displayPage, cursor, shouldKeepSort, sortBy, sortOrder, sortSource, selectedFacets,
    hasQueryParam, hasPageSizeParam, releaseDateSortField } = await loadSearchPage(url, query, searchType, PUBLIC_SEARCH_API, { signal: Astro.request.signal });
if (status !== 200) Astro.response.status = status;
---
<script src="./client/controller.js"></script>
{requestError && <p role="alert">{requestError}</p>}
<section
  id="search-results-shell"
  class="vf-content | vf-u-grid-example | vf-grid vf-grid__col-5"
  data-total-results={String(totalResults)}
  data-page-size={String(pageSize)}
  data-results-count={String(results?.length ?? 0)}
  data-capped-page={String(cappedPage)}
  data-current-page={String(displayPage)}
  data-display-page={String(displayPage)}
  data-has-cursor={cursor ? "true" : "false"}
>
  <div class="vf-u-grid__col--span-3--sm vf-u-grid__col--span-1--lg vf-u-grid__col--span-1--xl">
    <br />
    <div style="display: flex;">        
      <div style="padding-top: 0.4em">
      <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 16 16">
        <rect width="16" height="16" fill="none" />
        <path fill="currentColor" d="M6 4a1 1 0 1 1-2 0a1 1 0 0 1 2 0M2 4a3 3 0 0 1 3-3h6a3 3 0 1 1 0 6H5a3 3 
          0 0 1-3-3m3-2a2 2 0 1 0 0 4h6a2 2 0 1 0 0-4zm6 10a1 1 0 1 0 0-2a1 1 0 0 0 0 2m-9-1a3 3 0 0 1 3-3h6a3 
          3 0 1 1 0 6H5a3 3 0 0 1-3-3m3-2a2 2 0 1 0 0 4h6a2 2 0 1 0 0-4z" />
        </svg> 
      </div>
      <div><h3> Filter by</h3></div>
    </div>
    <div>
      <form id="facets" method="GET" action={searchPageURL} class="vf-form">
        {Object.entries(facets).map(([id, facet]) => <>
        <SearchFacet facet={facet} id={id} />
        </>
        )}
        <input type="hidden" name="query" value={query}  />
        {url.searchParams.has("pagination.page_size") && (
          <input type="hidden" name="pagination.page_size" value={String(pageSize)} />
        )}
        {shouldKeepSort && (
          <>
            <input type="hidden" name="sort_by" value={sortBy} />
            <input type="hidden" name="sort_order" value={sortOrder} />
            <input type="hidden" name="sort_source" value={sortSource} />
          </>
        )}
        <input
          type="hidden"
          id="has_converted_image_hidden"
          name="has_converted_image"
          value="true"
          disabled={!url.searchParams.has("has_converted_image")}
        />        
      </form>
    </div>
  </div>
  <div class="vf-u-grid__col--span-1--sm  vf-u-grid__col--span-2--md vf-u-grid__col--span-4--lg vf-u-grid__col--span-4--xl" style="min-width:50%">
    { (hasQueryParam) && (
        <section class="vf-content">
          <div class="vf-grid vf-grid__col-3">
            <div class="vf-grid__col--span-2">{query && (<h2>Search results for <a href={`${searchPageURL}?query=${query}`}><strong>{query}</strong></a></h2>)}</div>
            <div></div>
          </div>
          <section class="vf-content">
            <div class="results-header">
              <div class="results-count">
                <span id="paginated-results">
                    {results !== undefined && results?.length != 0 && totalResults > 0 && `${(Math.max(1, displayPage) - 1) * paginationData.page_size + 1} - ${Math.min(((Math.max(1, displayPage) - 1) * paginationData.page_size) + results.length, totalResults)} of ${totalResults} results`}
                  </span>
                </div>
                <div class="vf-form" id="resultsToolbar">
                  { searchType === "study"? (
                      <div class="converted-study-switch">
                        <span> Studies with viewable images:  </span>
                        <label class="switch">
                          <input type="checkbox" id="convertedImageToggle">
                          <span class="slider round"></span>
                        </label>
                      </div>
                    ) : (
                      <div class="converted-image-switch">
                        <span> Viewable Images:  </span>
                        <label class="switch">
                          <input type="checkbox" id="convertedImageToggle">
                          <span class="slider round"></span>
                        </label>
                      </div>

                    )
                  }
                  <div class="controls-container">
                    <div class="controls-inner">
                      <div class="toggle-switch">
                        <label class="toggle-option">
                            <input type="radio" name="view" value="card-view" checked>
                            <span class="toggle-label">Cards</span>
                        </label>
                        <label class="toggle-option">
                            <input type="radio" name="view" value="table-view">
                            <span class="toggle-label">Table</span>
                        </label>
                        <label class="toggle-option">
                            <input type="radio" name="view" value="grid-view">
                            <span class="toggle-label">Grid</span>
                        </label>
                      </div>
                    </div>
                  </div>
                  <div class="toolbar-selects">
                    <select name="pageSize" id="pageSize" class="toolbar-select vf-u-type__text-body--5" aria-label="Page size">
                      <option value="12" selected={!hasPageSizeParam || pageSize === 12}>Page size</option>
                      <option value="30" selected={pageSize === 30}>30 per page</option>
                      <option value="60" selected={pageSize === 60}>60 per page</option>
                      <option value="90" selected={pageSize === 90}>90 per page</option>
                    </select>
                    <select name="sort_by" id="sortBy" class="toolbar-select vf-u-type__text-body--5" aria-label="Sort by">
                      <option value="" selected={!shouldKeepSort}>Sort by</option>
                      <option value="relevance" selected={shouldKeepSort && sortBy === "relevance"}>Relevance</option>
                      <option value={releaseDateSortField} selected={shouldKeepSort && sortBy === releaseDateSortField}>Release date</option>
                      <option value="accession_id" selected={shouldKeepSort && sortBy === "accession_id"}>Accession</option>
                    </select>
                    <select name="sort_order" id="sortOrder" class="toolbar-select vf-u-type__text-body--5" aria-label="Sort order">
                      <option value="" selected={!shouldKeepSort}>Sort order</option>
                      <option value="desc" selected={shouldKeepSort && sortOrder === "desc"}>Descending</option>
                      <option value="asc" selected={shouldKeepSort && sortOrder === "asc"}>Ascending</option>
                    </select>
                  </div>
                </div>
            </div>
            <div id="selected-facets" style="margin-top: 0.5rem; align-items: center;">
              <SearchSelectedFacet query={query} url={searchPageURL} text="Query" kind="query" pageSize={pageSize} selectedFacets={selectedFacets} sortBy={shouldKeepSort ? sortBy : ""} sortOrder={shouldKeepSort ? sortOrder : ""} sortSource={sortSource} />
              {Object.entries(facets).map(([facetKey, facet]) => (
                <SearchSelectedFacet
                  key={facetKey}
                  selectedList={facet.selectedValue}
                  url={searchPageURL}
                  text={facet.title}
                  query={query}
                  selectedFacets={selectedFacets}
                  kind={facet.kind}
                  minVal={facet?.selectedMin || ""} 
                  maxVal={facet?.selectedMax || ""}
                  pageSize={pageSize}
                  sortBy={shouldKeepSort ? sortBy : ""}
                  sortOrder={shouldKeepSort ? sortOrder : ""}
                  sortSource={sortSource}
                />
              ))}
            </div>
            <div id="card-view">
            <div class="vf-card-container vf-card-container__col-4 vf-u-fullbleed"  style="--vf-card__image--aspect-ratio: 16 / 9; --vf-card-container__inner--grid-gap: 0.5rem;">
              <div class="vf-card-container__inner">
              {results === undefined || results.length === 0 ? (
                <p>No results found.</p>
              ) : (
                results?.map((item) => (
                  searchType === "study"? (<StudyCard study={item._source} highlight={item.highlight} query={query} studyPageRoot="study" />):
                  (<ImageCard image={item._source} highlight={item.highlight} query={query} imagePageRoot="image" />)
                  
                ))
              )}
              </div>
            </div>
            </div>
            <div id="table-view" style="display: none;">
              {
                results === undefined || results.length === 0 ? <p>No results found.</p> 
                  : <SearchResultsTable results={results} resultType={searchType} query={query}/>
              }
            </div>
            <div id="grid-view" style="display: none;">
              <div class="column-toggle-container">
                <div class="column-toggle">
                    <label class="column-option">
                        <input type="radio" name="columns" value="3">
                        <span class="column-label">3 Columns</span>
                    </label>
                    <label class="column-option">
                        <input type="radio" name="columns" value="4" checked>
                        <span class="column-label">4 Columns</span>
                    </label>
                    <label class="column-option">
                        <input type="radio" name="columns" value="5">
                        <span class="column-label">5 Columns</span>
                    </label>
                </div>
              </div>
              <section class="grid-container">
                  <div class="grid-inner">
                    {results === undefined || results.length === 0 ? (
                      <p>No results found.</p>
                    ) : (
                      results?.map((item) => (
                        <SearchResultsCompactCards result={item._source} resultType={searchType} highlight={item.highlight}/>
                      ))
                    )}
                  </div>
              </section>
            </div>
            {results === undefined || results?.length != 0 && (<br/><PaginationControl  paginationData={paginationData} displayPage={displayPage}/>)}
          </section>
        </section>
      )
    }
  </div>
</section>
