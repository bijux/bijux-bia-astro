---
import HighlightedText from "./HighlightedText.astro";
interface Props { fields: [string, string][]; }
const { fields } = Astro.props;
---
{fields.map(([key, text], index) => <Fragment>
    {index > 0 && <br />}
    <span class="highlight"><b>{key.replace(/.*\./g, "").replace(/_/g, " ")}: </b><i><HighlightedText text={text} /></i></span>
</Fragment>)}
