---
import { navigationURL } from "../../security/urls.mjs";
const { ftpHttpsLink, globusLink } = Astro.props;

---
<a target="_blank" href={navigationURL(ftpHttpsLink+"/") ?? undefined} class="vf-button vf-button--primary vf-button--sm bia-button">Browse files on HTTP</a>
<a target="_blank" href={navigationURL(globusLink) ?? undefined} class="vf-button vf-button--primary vf-button--sm bia-button">Browse files on Globus</a>
