---
import { navigationURL, resourceURL } from "../../security/urls.mjs";


import ImageActions from "./ImageActions.astro";
import BaseLayoutWithBreadcrumbs from '../../layouts/BaseLayoutWithBreadcrumbs.astro';
import DatasetDetail from '../metadata/DatasetDetail.astro';
import empiarLogo from "../../assets/bioimage-archive/EMPIAR_logo.png";
import Specimen from './Specimen.astro';
import SpecimenTrackTable from './relationships/SpecimenTrackTable.astro';
import RelatedImagesTable from './relationships/RelatedImagesTable.astro';
import InputImagesTable from './relationships/InputImagesTable.astro';
import ImageFileMetadata from './ImageFileMetadata.astro';

import fieldMap from "../metadata/field-labels.json";
import fallbackImage from "../../assets/bioimage-archive/image_fallback.png"
import { buildITKViewerURL, buildVizarrViewerURL, getPublicVisualisationURI } from "./viewers.mjs";
import { getSimpleAttributeValue } from "../metadata/records.mjs";
import { selectInteractiveRepresentation } from "./representations.mjs";
import { type ImagePageData } from "./load-image.ts";
import { formatPhysicalVoxelDimensions, formatPhysicalDimensions } from "../../formatting/physical-dimensions.js";
import { formatPixelDimensions } from "../../formatting/units.mjs";
import { type ImageCreationProcess, type SpecimenInfo } from "../../api/types.ts"

const imageAcquisitionMap = fieldMap["image_acquisition"];
const annotationMethodMap = fieldMap["annotation_method"];
const protocolMap = fieldMap["protocol"];

const { data } = Astro.props as { data: ImagePageData };
const { image, study: imageStudy, dataset: imageDataset,
    inputImages: input_images, upstreamImages: upstream_images,
    downstreamImages: downstream_display_images, segmentationImages: own_segmentation_images,
    specimen, inheritedSpecimens: inherited_specimens, hasSpecimenTracks: hasSpecimenTrackContent } = data;

const curatedVizarr = image.additional_metadata?.find(attr => attr.name === "recommended_vizarr_representation" && attr.provenance === "bia_curation")?.value;
const vizarrRep = curatedVizarr && typeof curatedVizarr === 'object' && !Array.isArray(curatedVizarr) && 'attribute_key' in curatedVizarr ? curatedVizarr.attribute_key : null;
const vizarrRepUuid = vizarrRep ?? getSimpleAttributeValue(image, "recommended_vizarr_representation");
const interactiveImageRepresentation = selectInteractiveRepresentation(image, vizarrRepUuid);

const accession_id = image ? image.accession_id : "";
const isEMPIAR = accession_id.startsWith("EMPIAR");
const viewerSourceURI = getPublicVisualisationURI(interactiveImageRepresentation?.file_uri?.[0]);
const vizarrIFrameSource = interactiveImageRepresentation ? buildVizarrViewerURL(viewerSourceURI) : null
const itkRepUuid = getSimpleAttributeValue(image, "recommended_itk_representation");
const itkLink = itkRepUuid ? buildITKViewerURL(viewerSourceURI) : null

const pref_ng_image_rep_uuid = getSimpleAttributeValue(image, "preferred_neuroglancer_image_representation_uuid")
const pref_ng_image_rep = image.representation.find((rep) => rep.uuid === pref_ng_image_rep_uuid)
const ng_link = pref_ng_image_rep ? getSimpleAttributeValue(pref_ng_image_rep, "neuroglancer_view_link") : null

const creation_process: ImageCreationProcess = image?.creation_process || {};

const thumbnail_uri = getSimpleAttributeValue(image, "thumbnail_uri")?.[0];

const userProvidedAttribute = image.file_list_attributes?.[0]?.value?.attributes || {};
const breadcrumbs = [
  "/bioimage-archive",
  "/bioimage-archive/studies",
  `/bioimage-archive/study/${imageStudy.accession_id}`
]

---

<BaseLayoutWithBreadcrumbs pageTitle={image.uuid} breadcrumbs={breadcrumbs}>
  <Fragment>
    <div class="vf-stack vf-stack--500">
        <section class="vf-content | embl-grid embl-grid--has-centered-content">
            <div></div>
            <div>
                <h1 class="vf-intro__heading vf-intro__heading--has-tag">
                    { imageStudy.accession_id }
                    {isEMPIAR && (<img src={empiarLogo.src} alt="EMPIAR"  class="vf-badge vf-badge--secondary vf-badge--phases" style="border: 0px solid #ccc;"/>)}
                </h1>
                <h2 class="vf-intro__subheading">{imageStudy.title}</h2>
                <p class="studytitle">{imageDataset?.title}</p>
                <a href={ "/bioimage-archive/study/" + imageStudy.accession_id} class="vf-button vf-button--primary vf-button--sm bia-button">Study Page</a>
            </div>
        </section>
        <section class="vf-content | embl-grid embl-grid--has-centered-content">
            <div style="word-wrap: break-word;">
                {
                    interactiveImageRepresentation && (
                        <span>
                            <h3>Image metadata</h3>
                            <b>Physical image size: </b> {formatPhysicalDimensions(image) }<br />
                            <b>Physical voxel size: </b> {formatPhysicalVoxelDimensions(interactiveImageRepresentation) }<br />
                            <b>Pixel image size: </b> {formatPixelDimensions(interactiveImageRepresentation)}<br />
                            {interactiveImageRepresentation.size_c && (<div><b>Number of channels:</b> {interactiveImageRepresentation.size_c}</div>)}
                            {interactiveImageRepresentation.size_t && (<div><b>Number of timesteps:</b> {interactiveImageRepresentation.size_t}</div>)}
                        </span>
                    )
                }
                <ImageFileMetadata filePaths={image.file_path} attributes={userProvidedAttribute} />
            </div>
            <div style="display: flex; justify-content: center;">
                {vizarrIFrameSource ? (
                    <iframe
                        style="width: 100%; height: 500px"
                        name="vizarr"
                        allow={import.meta.env.PUBLIC_ALLOW_LOCAL_VIEWERS === "true" ? "loopback-network; local-network-access" : undefined}
                        src={vizarrIFrameSource}
                        title={`Vizarr viewer for image ${image.uuid}`}
                    ></iframe>
                ) : thumbnail_uri ? (
                    <img style="width: 100%; height: 500px" src={resourceURL(thumbnail_uri) ?? undefined} alt={`Preview of image ${image.uuid}`} />
                ) : (
                    <img style="height: 500px;" src={fallbackImage.src} alt="Fallback image preview" />
                )}
            </div>

            <div>
                <h3>Access images</h3>
                License: <a href={navigationURL(image.licence_details.uri) ?? undefined}>{image.licence_details.label}</a> <br/>
                <br/>
                <a href={"/bioimage-archive/help/downloading-data#aws_client_download"}>How to download this image</a><br/>
                <br/>
                <ImageActions showCopy={Boolean(interactiveImageRepresentation)}
                    copyURI={viewerSourceURI ?? interactiveImageRepresentation?.file_uri?.[0]}
                    vizarrURL={vizarrIFrameSource} itkURL={itkLink} neuroglancerLink={ng_link} />
            </div>
        </section>

        <hr/>

        <section class="vf-content | embl-grid embl-grid--has-centered-content">
            <div class="vf-section-header">
                <h2 class="vf-section-header__heading" >Study</h2>
            </div>
            <div style="overflow-wrap: anywhere;">
                <b>Title</b>: {imageStudy.title}<br/>
                <b>Description:</b> {imageStudy.description} <br/>
                <b>Licence:</b> <a href={navigationURL(imageStudy.licence_details.uri) ?? undefined}>{imageStudy.licence_details.label}</a> <br/>
            </div>
        </section>

        <hr/>

        <section class="vf-content | embl-grid embl-grid--has-centered-content">
            <div class="vf-section-header">
                <h2 class="vf-section-header__heading" >Dataset</h2>
            </div>
            <div>
                <b>Title</b>: {imageDataset?.title}<br/>
                <b>Description:</b> {imageDataset?.description}<br/>
            </div>
        </section>

        <hr/>

        <section class="vf-content | embl-grid embl-grid--has-centered-content">
            <div class="vf-section-header">
                <h2 class="vf-section-header__heading" >Subject</h2>
            </div>
            <div>
            {
                specimen != null && (
                    <Specimen specimen={specimen}/>
                )
            }
            {
                specimen == null && inherited_specimens && inherited_specimens.length > 0 && (
                    <b>Source Specimen Information</b>
                    <div class="metadata-fields">
                        {inherited_specimens.map((specimen: SpecimenInfo) => (
                            <Specimen specimen={specimen}/>
                        ))}
                    </div>
                )
            }
            </div>
        </section>

        <hr/>

        <section class="vf-intro | embl-grid embl-grid--has-centered-content | section-spacing">
            <div class="vf-section-header">
                <h2 class="vf-section-header__heading" >Creation</h2>
            </div>
            <div>
                {
                    "acquisition_process" in creation_process &&
                        creation_process.acquisition_process?.length > 0 && (
                            <b>Image Acquisition Protocols:</b>
                            <div class="metadata-fields">
                                {creation_process.acquisition_process.map(
                                    (image_acquisition) => (
                                        <DatasetDetail
                                            data={image_acquisition}
                                            fieldMap={imageAcquisitionMap}
                                        />
                                    ),
                                )}
                            </div>
                        )
                }
                {
                    "annotation_method" in creation_process &&
                        creation_process.annotation_method?.length > 0 && (
                            <b>Image Acquisition Protocols:</b>
                            <div class="metadata-fields">
                                {creation_process.annotation_method.map(
                                    (annotation_method) => (
                                        <DatasetDetail
                                            data={annotation_method}
                                            fieldMap={annotationMethodMap}
                                        />
                                    ),
                                )}
                            </div>
                        )
                }
                {
                    "protocol" in creation_process &&
                        creation_process.protocol?.length > 0 && (
                            <b>Image Acquisition Protocols:</b>
                            <div class="metadata-fields">
                                {creation_process.protocol.map(
                                    (protocol) => (
                                        <DatasetDetail
                                            data={protocol}
                                            fieldMap={protocolMap}
                                        />
                                    ),
                                )}
                            </div>
                        )
                }
                {
                    input_images.length > 0 && (
                        <div>
                            <b>Input Images:</b>
                        </div>
                        <InputImagesTable images={input_images}/>
                    )
                }
            </div>
        </section>

        {
            hasSpecimenTrackContent && (
                <>
                    <hr/>
                    <section class="vf-intro | embl-grid embl-grid--has-centered-content | section-spacing">
                        <div class="vf-section-header">
                            <h2 class="vf-section-header__heading" >Specimen track</h2>
                        </div>
                        <div>
                            {
                                image.specimen_track_position === "terminal" && upstream_images.length > 0 && (
                                    <div>
                                        <b>This image is derived from these images:</b>
                                    </div>
                                    <SpecimenTrackTable images={upstream_images}/>
                                )
                            }
                            {
                                image.specimen_track_position === "segmentation" && input_images.length > 0 && (
                                    <div><b>This segmentation is derived from these images:</b></div>
                                    <RelatedImagesTable images={input_images}/>
                                )
                            }
                            {
                                image.specimen_track_position === "internal" && downstream_display_images.length > 0 && (
                                    <div><b>Images derived from this image:</b></div>
                                    <RelatedImagesTable images={downstream_display_images}/>
                                )
                            }
                            {
                                own_segmentation_images.length > 0 && (
                                    <div><b>Segmentation(s) derived from this image:</b></div>
                                    <RelatedImagesTable images={own_segmentation_images}/>
                                )
                            }
                        </div>
                    </section>
                </>
            )
        }
    </div>
  </Fragment>
</BaseLayoutWithBreadcrumbs>
<style>
  .metadata-fields { padding-left: 20px; }
</style>
