---
import { getThumbnail } from "../thumbnails.mjs";


const { images, imagePageRoot } = Astro.props;

---
<div class="bia-table-controls">
  <table id="viewable_input_images_table" class="display vf-table">
    <thead>
      <tr>
        <th>Preview</th>
        <th>UUID</th>
      </tr>
    </thead>
    <tbody>
      {
        images.map((image) => (
          <tr>
              <td>
                <a aria-label={`View image ${image.uuid}`} href={imagePageRoot ? `/bioimage-archive/${imagePageRoot}/${image.uuid}` : `/bioimage-archive/image/${image.uuid}`}><img alt="" class="vf-figure__image" style="max-height: 150px;" src={getThumbnail(image)}/></a>
              </td>
              <td>{image.uuid}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
          $("#viewable_input_images_table").DataTable({
            scrollX: true,
            columnDefs: [{ type: "natural", targets: 0 }],
          });
        });

</script>
