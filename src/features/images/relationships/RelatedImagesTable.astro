---
import "./relationship-tables.css";
import RelationshipRow from "./RelationshipRow.astro";

const { images } = Astro.props;
const validImages = images.filter((image) => image != null);
---
<div class="specimen-track-table">
  <table class="vf-table">
    <thead>
      <tr>
        <th>Position</th>
        <th>Label</th>
        <th>UUID</th>
        <th>File size</th>
      </tr>
    </thead>
    <tbody>
      {validImages.map((image) => <RelationshipRow image={image} />)}
    </tbody>
  </table>
</div>
