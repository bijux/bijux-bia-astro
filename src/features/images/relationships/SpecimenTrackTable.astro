---
import RelationshipRow from "./RelationshipRow.astro";
import { isRootImage } from './position.mjs';

const { images } = Astro.props;
const sortedImages = images
  .filter((image) => image != null)
  .sort((a, b) => (isRootImage(a) === isRootImage(b) ? 0 : isRootImage(a) ? 1 : -1));
---
<div class="specimen-track-table bia-table-controls">
  <table id="specimen_track_table" class="vf-table">
    <thead>
      <tr>
        <th>Position</th>
        <th>Label</th>
        <th>UUID</th>
        <th>File size</th>
      </tr>
      <tr>
        <th id="position_filter_cell"></th>
        <th></th><th></th><th></th>
      </tr>
    </thead>
    <tbody>
      {sortedImages.map((image) => <RelationshipRow image={image} />)}
    </tbody>
  </table>
</div>

<style>
  .specimen-track-table table {
    width: 100%;
    border-collapse: collapse;
  }
  .specimen-track-table th,
  .specimen-track-table td {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid #d2d2d2;
    font-size: 14px;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    $("#specimen_track_table").DataTable({
      order: [],
      orderCellsTop: true,
      columnDefs: [
        { type: "natural", targets: 0 },
        { orderable: false, targets: [1, 2] },
      ],
      initComplete: function () {
        this.api()
          .columns(0)
          .every(function (this: any) {
            const column = this;
            const select = $('<select><option value="">All positions</option></select>')
              .appendTo($("#position_filter_cell"))
              .on("change", function (this: HTMLSelectElement) {
                const value = $.fn.dataTable.util.escapeRegex(String($(this).val() ?? ""));
                column.search(value ? `^${value}$` : "", true, false).draw();
              });

            column
              .data()
              .unique()
              .sort()
              .each(function (positionText: string) {
                const option = document.createElement("option");
                option.value = positionText;
                option.textContent = positionText;
                select.append(option);
              });
          });
      },
    });
  });
</script>
