---
const { datasetUUIDsAndFileStats } = Astro.props;
---

<section class="vf-intro | embl-grid embl-grid--has-centered-content | section-spacing bia-table-controls">
    <div class="vf-section-header">
      <h2 class="vf-section-header__heading" id="transcript_files">
        Omics Component
      </h2>
    </div>
    <div>
      <p>
        Shows up to 1000 transcript or related files of any selected dataset.
      </p>
      <b>Dataset: </b>
      <select id="sotables_dataset_selector" class="form-select" data-dataset-uuids={JSON.stringify(datasetUUIDsAndFileStats)}>
        <option value="" disabled selected>Select a Dataset</option>
      </select>

      <table id="sotables_file_references_table" class="vf-table display"></table>
    </div>

    <script>
      import { copyWithFeedback } from "../../../components/ui/clipboard.mjs";
      import { escapeHtml } from "../../../security/html.mjs";
      import { boundedMap } from "../../../api/http.mjs";
      import { selectTranscriptFiles } from "./transcript-records.mjs";
      import { getFileReferences } from "../../../api/file-references.mjs";

      document.addEventListener("DOMContentLoaded", function () {
        const dropdown = document.getElementById("sotables_dataset_selector") as HTMLSelectElement; // Get the dropdown element
        const datasetDetails = JSON.parse(dropdown.dataset.datasetUuids); // Ensure datasetUuids is parsed correctly
        let tableRequest = 0;

        // Function to initialize or update the DataTable
        const initializeDataTable = async (datasetUuid, totalFiles) => {
            const request = ++tableRequest;
            // Destroy the existing DataTable instance if it exists
            if (($.fn.DataTable as any).isDataTable('#sotables_file_references_table')) {
                $('#sotables_file_references_table').DataTable().destroy();
                $('#sotables_file_references_table').empty(); // Clear the table's HTML content
            }

            // Fetch data and initialize the DataTable
            getFileReferences("https://wwwdev.ebi.ac.uk/bioimage-archive/api/v2", datasetUuid)
                .then((fileData) => {
                    if (request !== tableRequest) return;
                    const filteredFiles = selectTranscriptFiles(fileData);
                    // Initialize the DataTable
                    $('#sotables_file_references_table').DataTable({
                        data: filteredFiles,
                        columns: [
                            { data: "uuid", title: "File UUID", render: value => escapeHtml(value) },
                            { data: "file_path", title: "File Name", render: value => escapeHtml(value) },
                            { data: "uri", title: "Actions", render: (data) => `<button type="button" class="copy-btn bia-button" data-uri="${escapeHtml(data)}">Copy Url</button>` },
                        ],
                        pageLength: 25,
                        searching: true,
                        ordering: true,
                        processing: true,
                        scrollX: true,
                        columnDefs: [{ type: "natural", targets: 0 }],
                        createdRow: (row) => {
                            $(row).find(".copy-btn").on("click", function () {
                                const link = $(this).data("uri");
                                void copyWithFeedback(this, link, { success: "URL Copied" });
                            });
                        }
                    });
                })
                .catch((error) => {
                    console.error("Error fetching data:", error);
                });
        };

        // Function to fetch dataset details including Data_Type
        const fetchDatasetDetails = async (datasetUuid) => {
            const fileData = await getFileReferences("https://wwwdev.ebi.ac.uk/bioimage-archive/api/v2", datasetUuid);
            return selectTranscriptFiles(fileData).length > 0;
        };


        // Populate the dropdown menu with dataset details
        const filteredDatasets = [];
        boundedMap(datasetDetails, async ([uuid, fileCount, title]) => {
            try { return await fetchDatasetDetails(uuid) ? [uuid, fileCount, title] : null; }
            catch { console.error("Optional transcript file inventory unavailable."); return null; }
        }).then(results => {
            for (const dataset of results.filter(Boolean)) {
                const [uuid, fileCount, title] = dataset;
                const option = document.createElement("option");
                option.value = uuid;
                option.text = String(title);
                dropdown.appendChild(option);
                filteredDatasets.push(dataset);
            }
            if (filteredDatasets.length) {
                const [uuid, fileCount] = filteredDatasets[0];
                dropdown.value = uuid;
                initializeDataTable(uuid, fileCount);
            }
        }).catch(() => { console.error("Transcript inventory could not be loaded."); });
        // Event listener for dropdown menu selection
        dropdown.addEventListener("change", () => {
            const selectedIndex = dropdown.selectedIndex; // Get the selected index
            if (selectedIndex > 0) { // Ignore the first "placeholder" option
                const [selectedUuid, totalFiles] = filteredDatasets[selectedIndex - 1]; // Adjust for 0-based index
                initializeDataTable(selectedUuid, totalFiles); // Initialize the table with selected dataset
            }
        });
        // Trigger a default load for the first dataset
        dropdown.addEventListener("datasetLoaded", () => {
            if (filteredDatasets.length > 0) {
                dropdown.selectedIndex = 1; // Automatically select the first dataset
                const [defaultUuid, defaultTotalFiles] = filteredDatasets[0];
                initializeDataTable(defaultUuid, defaultTotalFiles);
            }
        });
    });
    </script>
</section>
