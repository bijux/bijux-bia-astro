---
import { resourceURL } from "../../../security/urls.mjs";
import { scriptData } from "../../../security/html.mjs";
import ImageInfo from "./ImageInfo.astro";
import { buildVizarrViewerURL, getPublicVisualisationURI } from "../../images/viewers.mjs";
import { getSimpleAttributeValue } from "../../metadata/records.mjs";
const { annotatedImages, sourceImage } = Astro.props;

function getAttributes(image) {
  return image?.additional_metadata?.find(meta =>
    meta.name.startsWith("attributes_from_file_reference")
  )?.value?.attributes || {};
}

function parseNeuroglancerUrl(url: string) {
  try {
  if (url.length > 65536) return {};
  const fragment = url.split("#!")[1];
  if (!fragment) return {};
  const decoded = decodeURIComponent(fragment);
  const state = JSON.parse(decoded);
  const result: Record<string, { order: number; name: string }> = Object.create(null);
  if (!Array.isArray(state.layers) || state.layers.length > 1000) return result;
  state.layers.forEach((layer: any, index: number) => {
    const source = layer.source?.url ?? layer.source;
    const uuid = typeof source === "string" ? source.match(/\/S-[^\/]+\/([0-9a-f-]{36})\//)?.[1] : null;
    if (uuid) {
      result[uuid] = {
        order: index + 1,
        name: layer.name
      };
    }
  });
  return result;
  } catch { return {}; }
}

const sourceImageAtrributes = getAttributes(sourceImage)
const sourceImageRep = sourceImage.representation.find((r) => r.image_format === ".ome.zarr");
const sourceImgS3Url = getPublicVisualisationURI(sourceImageRep?.file_uri?.[0]) || "";
const sourceViewer = buildVizarrViewerURL(sourceImgS3Url);
const viewerPermissions = import.meta.env.PUBLIC_ALLOW_LOCAL_VIEWERS === "true" ? "loopback-network; local-network-access" : undefined;
const hasNeuroGlancerURL = resourceURL(getSimpleAttributeValue(sourceImage, "neuroglancer_view_link")) || "";
const ngLayers = parseNeuroglancerUrl(hasNeuroGlancerURL);
const sortedAnnotatedImages = annotatedImages
  .filter(img => ngLayers[img.uuid])
  .sort((a, b) => ngLayers[a.uuid].order - ngLayers[b.uuid].order);

let annotatedImage = sortedAnnotatedImages[0] ?? annotatedImages[0];
const annotatedImageAttributes = getAttributes(annotatedImage);
const annotatedImageRep = annotatedImage?.representation.find((r) => r.image_format === ".ome.zarr");
const annotatedImgS3Url = getPublicVisualisationURI(annotatedImageRep?.file_uri?.[0]) || "";
---
<section class="vf-content">
  {hasNeuroGlancerURL.length > 0? (
      <a target="_blank" href={hasNeuroGlancerURL} class="vf-button vf-button--primary vf-button--sm bia-button">Open overlay in Neuroglancer viewer</a>
    <div class="vf-grid">
      <div class="vf-grid__col--span-2"><iframe src={hasNeuroGlancerURL} allow={viewerPermissions} style="height: 600px; width: 100%;border: none;"></iframe></div>
    </div>
    <div class="vf-grid">
      <div style="min-width: 48%;">
      <ImageInfo text="Source Image" url={sourceImgS3Url} imageRep={sourceImageRep} imageAtrributes={sourceImageAtrributes} btnID="CopyURLButton"/>
      </div>
      <div style="min-width: 48%;">
        {sortedAnnotatedImages.map((img, index)=> {
          const imageRep = img.representation.find((r) => r.image_format === ".ome.zarr")
          const imageUrl = getPublicVisualisationURI(imageRep?.file_uri?.[0]) || "";
            return (
              <ImageInfo text={`Annotation ${index+1}`} url={imageUrl} imageRep={imageRep} imageAtrributes={getAttributes(img)} btnID={`CopyAnnotationButton${index+1}`}/><br>
            )
        }
    )}
      </div>
    </div>
  )
  :
  annotatedImages.length > 0 ? (
    <>
      <div class="vf-grid" style="display: flex; gap: 1rem;">
        <div style="min-width: 48%"><h3><span>Source Image</span></h3><div>
            {sourceViewer ? <iframe src={sourceViewer} allow={viewerPermissions} style="border: none;flex:1;height: 500px;width:100%;min-width:48%" title="Vizarr viewer for source image"></iframe> : <p>Viewer unavailable for this representation.</p>}
          </div>
          <ImageInfo text="Source Image" url={sourceImgS3Url} imageRep={sourceImageRep} imageAtrributes={sourceImageAtrributes} btnID="CopyURLButton"/>
        </div>
        <div style="min-width: 48%">
          <h3><span>Annotated Image <span id="AnnotatedImageLength">1</span> of {annotatedImages.length}</span></h3>
          <div style="flex: 1; position: relative; overflow: hidden;">
            <span class="imageslider"><button onclick="slide(-1)" id="image-slider" class="slider-left-button"></button></span>
            <div id="slider">
              {annotatedImages.map((img) => {
                const rep = img.representation?.find((r) => r.image_format === ".ome.zarr");
                const sourceUrl = getPublicVisualisationURI(rep?.file_uri?.[0]);
                const viewer = buildVizarrViewerURL(sourceUrl);
                return (
                  <div id={img.uuid} style="min-width:100%">
                  {viewer ?
                  <iframe
                    src={viewer}
                    allow={viewerPermissions}
                    style="height: 500px; border: none;width:100%"
                    title={`Vizarr viewer for annotation ${img.uuid}`}
                  ></iframe> : <p>Viewer unavailable for this representation.</p>}
                  </div>
                );
              })}
            </div>
            <span class="imageslider"><button onclick="slide(1)" class="slider-right-button"></button></span>
          </div>
          <div style="margin-top: 0.3em;">
          {annotatedImages.length > 0 && (
            <ImageInfo text="Annotation" url={annotatedImgS3Url} imageRep={annotatedImageRep} imageAtrributes={annotatedImageAttributes} btnID="CopyAnnotationButton"/>
          )}
          </div>
        </div>
      </div>
    </>
  ) : (
    <>
      <h3><span>Source Image</span></h3>
      {sourceViewer ? <iframe src={sourceViewer} allow={viewerPermissions} style="height: 500px; width: 100%;border: none;" title="Vizarr viewer for source image"></iframe> : <p>Viewer unavailable for this representation.</p>}
    </>
  )}

</section>
<script is:inline type="application/json" id="images-json" data-allow-local-viewers={String(import.meta.env.PUBLIC_ALLOW_LOCAL_VIEWERS === "true")} set:html={scriptData(annotatedImages)} />
<script>
    import { imageSizeMicrometres } from './image-dimensions.mjs';
    import { resourceURL } from "../../../security/urls.mjs";
    declare global { interface Window { slide: (direction: number) => void; } }
    const allowLocalViewers = document.getElementById("images-json")?.dataset?.allowLocalViewers === "true";
    const getPublicVisualisationURI = (uri) => {
      if (!uri) {
        return null;
      }

      try {
        const approved = resourceURL(uri, { allowLocal: allowLocalViewers });
        if (!approved) return null;
        const url = new URL(approved);
        if (url.hostname === "livingobjects-int.ebi.ac.uk") {
          url.hostname = "livingobjects.ebi.ac.uk";
        }
        return url.toString();
      } catch {
        return null;
      }
    };

    const buildVizarrViewerURL = (uri) => {
      if (!uri) {
        return "";
      }

      const url = new URL("https://livingobjects.ebi.ac.uk/bioimaging-01-pub/bia-zarr-test/vizarr/index.html");
      url.searchParams.set("source", uri);
      return url.toString();
    };

    const buildITKViewerURL = (uri) => {
      if (!uri) {
        return "";
      }

      const url = new URL("https://kitware.github.io/itk-vtk-viewer/app/");
      url.searchParams.set("fileToLoad", uri);
      return url.toString();
    };

    const slider = document.getElementById("slider");
    const numberOfAnnotatedImages = slider?.children.length ?? 0;
    if(!slider || numberOfAnnotatedImages <= 1){
      document.querySelectorAll<HTMLElement>(".imageslider").forEach(control => { control.style.display = "none"; });
    }else{
      let currentSlide = 0;
      const slides = slider.children;
      const updateMetadata = (uuid) => {
          const image = JSON.parse(document.getElementById("images-json").textContent).find(ai => ai.uuid === uuid)
          const rep = image.representation?.find((r) => r.image_format === ".ome.zarr") ?? {};
          const attributes = image.additional_metadata?.find(meta =>
              meta.name.startsWith("attributes_from_file_reference")
          )?.value?.attributes || {};
          const [micronX, micronY] = imageSizeMicrometres(rep);
          document.getElementById("annotated-size").innerText = `${micronX}μm x ${micronY}μm`;
          document.getElementById("annotated-pixels").innerText = `${rep.size_x ?? "Not reported"} x ${rep.size_y ?? "Not reported"} pixels`;
          document.getElementById("annotated-channels").innerText = `${rep.size_c ?? "Not reported"} channels`;
          document.getElementById("annotated-timesteps").innerText = `${rep.size_t ?? "Not reported"} timesteps`;
          const metaContainer = document.getElementById("annotated-metadata");
          const heading = document.createElement("h3");
          heading.textContent = "Additional metadata";
          metaContainer.replaceChildren(heading);
          Object.entries(attributes).forEach(([key, value]) => {
              const line = document.createElement("div");
              const label = document.createElement("b");
              label.textContent = `${key}:`;
              line.append(label, document.createTextNode(` ${value}`), document.createElement("br"));
              metaContainer.appendChild(line);
          });
          const s3url = getPublicVisualisationURI(rep.file_uri?.[0]) ?? "";
          const copyBtn = document.getElementById("CopyAnnotationButton");

          copyBtn.dataset.url = s3url;

          for (const [id, destination] of [["OpenAnnotationInVizarr", buildVizarrViewerURL(s3url)], ["OpenAnnotationInITK", buildITKViewerURL(s3url)]]) {
            const link = document.getElementById(id);
            if (link instanceof HTMLAnchorElement) {
              if (destination) link.href = destination;
              else link.removeAttribute("href");
            }
          }
          const studyInfo = JSON.parse(document.getElementById("study-json").textContent)
          const annotationTypeMethod = studyInfo.find((dataset) => dataset.uuid === image.submission_dataset_uuid)?.annotation_process?.[0];
          const panel = Array.from(document.querySelectorAll<HTMLElement>("[data-annotation-dataset]"))
              .find(element => element.dataset.annotationDataset === image.submission_dataset_uuid);
          if (panel) {
              const type = panel.querySelector<HTMLElement>("[data-annotation-type]");
              const method = panel.querySelector<HTMLElement>("[data-annotation-method]");
              if (type) type.innerText = annotationTypeMethod?.title ?? "";
              if (method) method.innerText = annotationTypeMethod?.protocol_description || annotationTypeMethod?.annotation_criteria || "";
          }
      };
      window.slide = function(direction: number) {
          const total = slides.length;
          currentSlide = (currentSlide + direction + total) % total;
          slider.style.transform = `translateX(-${currentSlide * 100}%)`;
          const currentUUID = slides[currentSlide].id;
          document.getElementById("AnnotatedImageLength").innerText = String(currentSlide+1);
          updateMetadata(currentUUID);
      };
      updateMetadata(slides[0].id);
    }

</script>
