---
import ImageMetadata from "./ImageMetadata.astro";
import { buildITKViewerURL, buildVizarrViewerURL, getPublicVisualisationURI } from "../../images/viewers.mjs";


const { url, imageRep, imageAtrributes, text, btnID} = Astro.props;
const publicUrl = getPublicVisualisationURI(url);
const vizarrHref = buildVizarrViewerURL(publicUrl);
const itkHref = buildITKViewerURL(publicUrl);

// Preserve carousel hooks for the single annotation pane; repeated panes use their copy-button key.
const viewerPrefix = text === "Annotation" ? "OpenAnnotation" : text === "Source Image" ? "OpenSource" : btnID;
const vizarrViewer = `${viewerPrefix}InVizarr`;
const itkViewer = `${viewerPrefix}InITK`;
const metadataIdPrefix = text === "Annotation" ? "annotated" : btnID;

---
<div style="min-width: 48%">
    <a target="_blank" href={vizarrHref ?? "#"} id={vizarrViewer} class="vf-button vf-button--primary vf-button--sm bia-button">Open {text} in Vizarr viewer</a>
    <a target="_blank" href={itkHref ?? "#"} id={itkViewer} class="vf-button vf-button--primary vf-button--sm bia-button">Open {text} in ITK viewer</a>
    <button class="vf-button vf-button--primary vf-button--sm bia-button" id={btnID} data-url={publicUrl ?? url}>Copy {text} OME-Zarr URI</button><br/>
    <ImageMetadata idPrefix={metadataIdPrefix} imageRep={imageRep} imageAtrributes={imageAtrributes} />
</div>
<script>
  import { copyWithFeedback } from '../../../components/ui/clipboard.mjs';
  window.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLButtonElement>("button[data-url]").forEach(btn => {
      btn.addEventListener("click", () => copyWithFeedback(btn, btn.dataset.url));
    });
  });
</script>
