---
import ImagePage from '../../../../features/galleries/ai/ImagePage.astro';
import { createRequestClient } from '../../../../api/client.mjs';
import { loadGalleryImage } from '../../../../features/galleries/load-image.mjs';
import { selectAnnotationImages } from '../../../../features/galleries/ai/annotations.mjs';
export const prerender = false;
const client = createRequestClient(Astro.request.signal);
const data = await loadGalleryImage(Astro.params.uuid, client);
if (!data) return new Response('Image not found.', { status: 404 });
const annotatedImages = selectAnnotationImages(await client.getDerivedImages(data.image.uuid), data.image.uuid);
---
<ImagePage data={{ ...data, annotatedImages }} />
