---
import BaseLayoutWithBreadcrumbs from "../../../../layouts/BaseLayoutWithBreadcrumbs.astro";
import BenchmarkedDatasetPage from "../../../../features/galleries/ai/benchmarking/BenchmarkedDatasetPage.astro"
import { createRequestClient } from "../../../../api/client.mjs";
import { type Study } from "../../../../api/types.ts"
import additionalStudyMetadata from "../../../../data/ai-dataset-benchmarking/additional-study-metadata.json"
import tableInfo from "../../../../data/ai-dataset-benchmarking/model-dataset-table.json"


import { loadDatasetNames, loadAnnotationStudies } from '../../../../features/galleries/ai/benchmarking/load-studies.mjs';
export function getStaticPaths() {
  return Object.keys(additionalStudyMetadata).map((id) => {
    return {
      params: { accessionID: id },
    };
  });
}

const { accessionID } = Astro.params;
const client = createRequestClient(Astro.request.signal);
const study = await client.getStudyFromApiByAccession(accessionID) as Study;
const datasetUUIDNameMap = await loadDatasetNames(tableInfo.filter(row => row.study === accessionID), client);
const studyMetadata = await loadAnnotationStudies(study, additionalStudyMetadata[accessionID].dataset, client);

const breadcrumbs = [
  "/bioimage-archive",
  "/bioimage-archive/galleries",
  "/bioimage-archive/galleries/ai",
  "/bioimage-archive/galleries/ai/analysed-studies",
]

---

<BaseLayoutWithBreadcrumbs pageTitle={accessionID} breadcrumbs={breadcrumbs}>
  <BenchmarkedDatasetPage datasetUUIDNameMap={datasetUUIDNameMap} accessionID={accessionID} studyMetadata={studyMetadata} additionalStudyMetadata={additionalStudyMetadata} tableInfo={tableInfo}/>
</BaseLayoutWithBreadcrumbs>


