---
import ImagePage from '../../../../features/galleries/spatialomics/ImagePage.astro';
import { createRequestClient } from '../../../../api/client.mjs';
import { loadGalleryImage } from '../../../../features/galleries/load-image.mjs';
export const prerender = false;
const client = createRequestClient(Astro.request.signal);
const data = await loadGalleryImage(Astro.params.uuid, client);
if (!data) return new Response('Image not found.', { status: 404 });
---
<ImagePage data={data} />
