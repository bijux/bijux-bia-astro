---
import ImagePage from '../../features/images/ImagePage.astro';
import { createRequestClient } from '../../api/client.mjs';
import { loadImagePage } from '../../features/images/load-image.ts';
export const prerender = false;
const data = await loadImagePage(Astro.params.uuid, createRequestClient(Astro.request.signal));
if (!data) return new Response('Image not found.', { status: 404 });
---
<ImagePage data={data} />
